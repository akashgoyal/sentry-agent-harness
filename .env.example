# --- Sentry ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
# Optional, used only to build "View in Sentry" links on the dashboard
SENTRY_ORG=
SENTRY_PROJECT=

# --- LLM provider: anthropic | openai | ollama | together ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TOGETHER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- MCP transport: stdio | sse ---
MCP_TRANSPORT=stdio
MCP_SSE_URL=http://localhost:8765/sse

# --- Agent behavior ---
MAX_ITERATIONS=6
TRUNCATION_LIMIT_CHARS=2000

# --- Data ---
DB_PATH=data/demo.db
